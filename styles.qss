/* --- Global Style --- */
QWidget {
    background-color: #1e1e1e; /* สีพื้นหลังหลัก (Dark Grey) */
    color: #cccccc;            /* สีตัวอักษรหลัก (Light Grey) */
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
}

/* --- QMainWindow & Splitter --- */
QMainWindow::separator {
    background-color: #333333;
    width: 2px;
    height: 2px;
}

QSplitter::handle {
    background-color: #333333;
}

QSplitter::handle:hover {
    background-color: #007acc; /* สีฟ้าเมื่อเอาเมาส์ไปโดนเส้นคั่น */
}

/* --- Buttons (เหมือน Bootstrap/Material) --- */
QPushButton {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;        /* มุมโค้ง */
    padding: 6px 12px;
    color: white;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #505050;
    border-color: #007acc;     /* ขอบสีฟ้าเมื่อ Hover */
}

QPushButton:pressed {
    background-color: #252526;
    border-color: #005f9e;
}

QPushButton:disabled {
    background-color: #2b2b2b;
    color: #666666;
    border-color: #333333;
}

/* --- Tables & Lists --- */
QTableWidget, QListWidget {
    background-color: #252526;
    alternate-background-color: #2d2d30; /* สีของแถวเลขคู่ (ให้ต่างจากพื้นหลังนิดนึง) */
    border: 1px solid #454545;
    border-radius: 4px;
    gridline-color: #333333;
    selection-background-color: #094771; /* สีพื้นหลังตอนเลือกแถว */
    selection-color: white;
    outline: 0; /* ลบเส้นประเวลาคลิกเลือก */
    color: #cccccc;
}

/* เอฟเฟคตอนเอาเมาส์ชี้ (Hover) */
QListWidget::item:hover {
    /* background-color: #3e3e42; */
    color: white;
}

/* จัดการ padding ใน Item ปกติ — อย่าใส่ color ที่นี่ จะทับ setForeground ของไฟล์ที่เปลี่ยน */
QListWidget::item {
    padding: 1px; /* เพิ่มระยะห่างให้ดูไม่อึดอัด */
}

QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #094771;
    color: white;
}

/* ตอนเลือกแล้วเอาเมาส์ชี้ซ้ำ (Selected + Hover) */
QTableWidget::item:selected:hover, QListWidget::item:selected:hover {
    background-color: #094771;
    color: #cccccc;
}

QHeaderView::section {
    background-color: #323232;
    color: #e0e0e0;
    padding: 4px;
    border: none;
    border-bottom: 1px solid #007acc; /* ขีดเส้นใต้หัวตารางให้ดู Modern */
    font-weight: bold;
}

/* --- Text Input & Logs --- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #3c3c3c;
    border: 1px solid #333333;
    border-radius: 4px;
    color: #d4d4d4;
    selection-background-color: #264f78;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #007acc; /* Highlight สีฟ้าเมื่อพิมพ์ */
}

/* --- Scrollbars (ทำให้ดูโมเดิร์น ไม่ใช่แท่งเทาๆ เดิมๆ) --- */
QScrollBar:vertical {
    border: none;
    background: #1e1e1e;
    width: 10px;
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #424242;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #686868;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; /* ซ่อนลูกศรขึ้นลง */
}

/* Horizontal Scrollbar style ... (Copy pattern from vertical) */
QScrollBar:horizontal {
    border: none;
    background: #1e1e1e;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: #424242;
    min-width: 20px;
    border-radius: 5px;
}
QScrollBar::handle:horizontal:hover { background: #686868; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

/* --- Status Bar --- */
QStatusBar {
    background-color: #4a4a4a; /* แถบสถานะสีฟ้า แบบ VS Code */
    color: white;
}

/* --- Menu Bar --- */
QMenuBar {
    background-color: #333333;
    color: #cccccc;
}
QMenuBar::item:selected {
    background-color: #505050;
}
QMenuBar::item:disabled {
    color: #6a6a6a;
}
QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #454545;
    padding: 2px;
}
QMenu::item {
    padding: 2px 4px 2px 8px;
    border: 1px solid transparent;
    border-radius: 3px;
    background-image: url(assets/menu-gutter-line.svg);
    background-repeat: repeat-y;
    background-position: left;
}
QMenu::item:selected {
    background-color: #094771;
    background-image: url(assets/menu-gutter-line.svg);
    background-repeat: repeat-y;
    background-position: left;
    border: 1px solid #007acc;
}
QMenu::item:disabled {
    color: #6a6a6a;
}
QMenu::item:selected:disabled {
    color: #6a6a6a;
    background-color: transparent;
}

QMenu::icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

QMenu::indicator {
    subcontrol-origin: padding;
    subcontrol-position: left center;
    left: 2px;
    width: 12px;
    height: 12px;
    margin: 0px 6px 0px 0px;
    border: 1px solid #8a8a8a;
    border-radius: 2px;
    background-color: #1e1e1e;
}

QMenu::indicator:non-exclusive:checked,
QMenu::indicator:exclusive:checked {
    border-color: #4fc3f7;
    background-color: transparent;
    image: url(assets/check-solid.svg);
}
QMenu::indicator:non-exclusive:unchecked:selected,
QMenu::indicator:exclusive:unchecked:selected {
    border-color: #cccccc;
    background-color: transparent;
}
QMenu::indicator:non-exclusive:checked:selected,
QMenu::indicator:exclusive:checked:selected {
    border-color: #ffffff;
    background-color: transparent;
    image: url(assets/check-solid.svg);
}

QCheckBox {
    spacing: 6px;
}
QMenu QCheckBox {
    margin-left: 4px;
}
QCheckBox::indicator {
    width: 11px;
    height: 11px;
    border: 1px solid #8a8a8a;
    border-radius: 2px;
    background-color: #1e1e1e;
}
QCheckBox::indicator:hover {
    border-color: #cccccc;
}
QCheckBox::indicator:checked {
    border-color: #4fc3f7;
    background-color: #007acc;
    image: url(assets/check-solid.svg);
}
QCheckBox::indicator:checked:hover {
    border-color: #ffffff;
}

/* --- ComboBox --- */
QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px 10px;
    color: #cccccc;
    min-width: 100px;
}

QComboBox:hover {
    border-color: #007acc;
}

QComboBox:focus {
    border: 1px solid #007acc;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
}

QComboBox::down-arrow {
    image: url(assets/angle-down-solid.svg);
    width: 18px;
    height: 18px;
    margin-right: 5px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #454545;
    selection-background-color: #094771;
    selection-color: white;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    background-color: #252526;
    color: #cccccc;
    padding: 6px 10px;
    min-height: 24px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3e3e42;
    color: white;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #094771;
    color: white;
}

/* --- List Widget --- */
QListWidget {
    background-color: #252526;
    border: 1px solid #454545;
    selection-background-color: #094771;
    selection-color: white;
    outline: 0;
    color: #cccccc;
}

QListWidget::item {
    padding: 5px;
}

QListWidget::item:hover {
    background-color: #3e3e42;
    color: white;
}

QListWidget::item:selected {
    background-color: #094771;
    color: white;
}